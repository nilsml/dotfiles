    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "miro@claude-plugins-official": true,
    "cc-plugin-you-should-know@builtin": true,
    "core@solea": true
  },
  "extraKnownMarketplaces": {
    "solea": {
      "source": {
        "source": "directory",
        "path": "/Users/nilsml/Dev/Solea/solea-agent-skills"
      }
    }
  },
  "tui": "fullscreen",
  "theme": "auto",
  "editorMode": "vim",
  "agentPushNotifEnabled": true,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  }
}
